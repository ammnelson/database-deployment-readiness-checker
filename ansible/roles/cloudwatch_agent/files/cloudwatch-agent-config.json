{
  "agent": {
    "metrics_collection_interval": 60
  },
  "metrics": {
    "namespace": "DDRC/BuildHost",
    "metrics_collected": {
      "mem": {
        "measurement": ["mem_used_percent"]
      },
      "disk": {
        "measurement": ["used_percent"],
        "resources": ["/"]
      }
    }
  },
  "logs": {
    "logs_collected": {
      "files": {
        "collect_list": [
          {
            "file_path": "/var/log/syslog",
            "log_group_name": "ddrc-module5-build-host-syslog",
            "log_stream_name": "{instance_id}"
          }
        ]
      }
    }
  }
}
